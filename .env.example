# ========================================================
# PayFlow Application Environment Configuration (Template)
# Copy this to .env in backend/ or root
# NEVER COMMIT REAL KEYS OR PRODUCTION SECRETS TO GIT
# ========================================================

# Django Core
SECRET_KEY=django-insecure-payflow-demo-development-key-change-in-production!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Defaults to SQLite for instant plug-and-play development)
# For PostgreSQL: postgresql://postgres:password@localhost:5432/payflow_db
DATABASE_URL=sqlite:///db.sqlite3

# JWT Settings
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Payment Provider Configuration (Sandbox / Pluggable)
# Supported options: mock, razorpay_sandbox, stripe_sandbox
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=pk_test_payflow_demo_sandbox_key
PAYMENT_PROVIDER_SECRET=sk_test_payflow_demo_sandbox_secret

# Fraud Simulation Thresholds
FRAUD_MAX_AMOUNT_LIMIT=50000
FRAUD_BURST_TIME_WINDOW_SECONDS=30
FRAUD_MAX_BURST_ATTEMPTS=4

# Celery & Redis (Optional / Async Tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
